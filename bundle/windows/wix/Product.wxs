<?xml version="1.0" encoding="utf-8"?>
<!--
  Suveren Gateway — per-user Windows installer (W4, suveren-as/docs/
  work-plan.md "Added 2026-10-02 — Windows installer").

  Per-user: installs under %LOCALAPPDATA%\Programs\Suveren with NO admin
  rights and NO UAC prompt — required because the target is a company laptop
  where the signed-in user has none. IT signs this with its own certificate
  (see build-signed.ps1) and distributes it via Intune in "user context".

  Scope="perUserOrMachine", not the stricter "perUser": WiX's own docs for
  the <Files> harvesting element below warn that strictly per-user packages
  generate components that fail ICE validation. "OrMachine" still DEFAULTS
  to a per-user install (this package never sets ALLUSERS) — it only adds
  the possibility of a per-machine install for someone who explicitly asks
  for one, which nothing here does.

  Installs files and a Start Menu shortcut — no HKCU\Environment writes.
  Starting the gateway and registering autostart go through the EXISTING
  `suveren-gateway service install` and detached-start CLI code paths, run
  from the launcher, which sets its own env scoped to just the gateway's
  process tree (see launcher.cmd and the InstallMarkerComponent note below
  for why this isn't done via HKCU\Environment).

  Two UNINSTALL-ONLY custom actions exist (see "Uninstall cleanup" below):
  stopping a running gateway so its own files aren't locked when Windows
  Installer tries to remove them, and deleting the scheduled task. IT
  uninstalls via Intune/msiexec directly, never through our CLI — without
  these, `msiexec /x` on its own left the scheduled task registered forever
  (confirmed on windows-latest CI), still pointing at a now-deleted launcher.

  UpgradeCode is FIXED — never change it across releases, or Windows treats
  every version as an unrelated product instead of an upgrade (orphaned old
  installs, no cleanup, no single "Suveren Gateway" entry in Settings).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="Suveren Gateway"
    Manufacturer="Suveren"
    Version="$(var.ProductVersion)"
    UpgradeCode="ab6e0a2e-6b3f-4c2a-9b7a-9b7b7e2a3b10"
    Language="1033"
    Scope="perUserOrMachine"
    Compressed="yes">

    <SummaryInformation
      Description="Suveren Gateway — Human Agency Protocol gateway (unsigned; sign and distribute via your own certificate)"
      Manufacturer="Suveren" />

    <!-- A newer version already installed refuses an older one outright,
         rather than silently downgrading files a newer connector set
         depends on. -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Suveren Gateway is already installed. Uninstall it first to install this older version."
      Schedule="afterInstallInitialize" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Per-user install root: %LOCALAPPDATA%\Programs\Suveren -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsRootFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Suveren" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SuverenMenuFolder" Name="Suveren" />
    </StandardDirectory>

    <!-- The payload: official Node win-x64, the gateway bundle, and every
         pinned connector — thousands of files from build-payload.mjs.
         Harvested by glob (WiX v5's built-in <Files> globbing) rather than
         hand-listed or run through heat.exe separately.

         ONE <Files> element covering the whole payload tree, not one per
         subdirectory (node\, gateway\, integrations\): WiX derives each
         generated File/Component Id from the path relative to the <Files>
         element's OWN Include base, so three separate globs can each
         independently produce the same relative path (e.g. two unrelated
         node_modules/<pkg>/package.json at the same depth) and collide —
         error WIX0091 "Duplicate File ... found", hit for real on the
         windows-latest CI runner. One glob over PayloadDir\** makes every
         relative path unique by construction, and still reproduces the
         exact node\ / gateway\ / integrations\ subtree layout underneath
         INSTALLFOLDER that launcher.cmd expects. -->
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <!-- The launcher — see bundle/windows/launcher.cmd's own doc comment. -->
    <Component Id="LauncherComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1001">
      <File Id="LauncherCmd" Source="$(var.LauncherSource)" Name="suveren-gateway.cmd" KeyPath="yes" />
    </Component>

    <!-- Start Menu entry that opens the gateway UI (starts it if needed,
         registering autostart on this first use — see launcher.cmd). -->
    <Component Id="StartMenuShortcutComponent" Directory="SuverenMenuFolder" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1002">
      <Shortcut
        Id="StartMenuShortcut"
        Name="Suveren Gateway"
        Description="Open the Suveren gateway"
        Target="[#LauncherCmd]"
        Arguments="open-ui"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveSuverenMenuFolder" Directory="SuverenMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Deliberately NOT writing anything to HKCU\Environment. An earlier
         version of this installer set SUVEREN_INSTALL_METHOD, SUVEREN_
         OFFLINE, SUVEREN_INTEGRATIONS_DIR and a PATH prepend for the bundled
         node there, reasoning that the Task Scheduler ONLOGON task (which
         carries no environment block of its own — see autostart-templates.
         mjs's buildWindowsTaskXml doc comment) needed it at the next logon.
         That is ACCOUNT-WIDE, not scoped to the gateway: it would shadow a
         developer's own Node (say, 24 or 25) with the bundled 22 for EVERY
         program that account runs, and force every OTHER gateway install
         under the same Windows user (an npm install, a dev checkout) into
         offline+managed mode too — unacceptable for an IT deploy to many
         people who may use Node themselves.

         Instead, `service install` (bundle/bin/suveren-gateway.js) routes
         the scheduled task through THIS launcher (SUVEREN_LAUNCHER env var,
         set by launcher.cmd before it forwards to the CLI) rather than
         node.exe+server.js directly — the launcher sets the same variables
         itself, scoped to just the one process tree it starts. See
         launcher.cmd's `run` subcommand and buildWindowsTaskXml's
         command/args override.

         This component now only carries a harmless per-user marker so the
         Feature below has something to reference; it does nothing at
         runtime. -->
    <Component Id="InstallMarkerComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1003">
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Suveren Gateway" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="LauncherComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="InstallMarkerComponent" />
    </Feature>

    <!-- Uninstall cleanup — the two things msiexec /x cannot do on its own.
         Both Return="ignore": a gateway that was never running, or a task
         that was already removed (e.g. via `suveren-gateway service
         uninstall` beforehand), must never fail the uninstall.

         Condition: REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE — a plain
         uninstall sets REMOVE="ALL"; so does the OLD version's removal
         during a MAJOR UPGRADE (RemoveExistingProducts uninstalls it), which
         ALSO sets UPGRADINGPRODUCTCODE. Excluding that case is deliberate:
         the scheduled task registered by `service install` points at
         [INSTALLFOLDER]suveren-gateway.cmd, and INSTALLFOLDER is the SAME
         per-user path across versions (fixed UpgradeCode, files replaced
         in-place) — deleting the task mid-upgrade would silently turn
         autostart off for every existing user on every update, and nothing
         in this package ever re-creates it. Left alone, the task keeps
         pointing at a valid (now-upgraded) launcher with no action needed.

         Both run `Execute="deferred"` (same install context — per-user,
         no elevation boundary to cross, so Impersonate="yes" is correct
         here as everywhere else in this package) and are scheduled before
         RemoveFiles: stop first, so the gateway's own files (node.exe, its
         DLLs) aren't locked when Windows Installer removes them; then
         delete the task, so nothing can restart the gateway (and re-lock
         those files) in the (very) small window before the files actually
         go. -->
    <CustomAction
      Id="StopGatewayOnUninstall"
      Directory="INSTALLFOLDER"
      ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]suveren-gateway.cmd&quot; stop"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="RemoveScheduledTaskOnUninstall"
      Directory="INSTALLFOLDER"
      ExeCommand="schtasks.exe /Delete /TN Suveren /F"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <Custom Action="StopGatewayOnUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveScheduledTaskOnUninstall" After="StopGatewayOnUninstall" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

  </Package>
</Wix>
