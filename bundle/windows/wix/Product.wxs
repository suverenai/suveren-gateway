<?xml version="1.0" encoding="utf-8"?>
<!--
  Suveren Gateway — per-user Windows installer (W4, suveren-as/docs/
  work-plan.md "Added 2026-10-02 — Windows installer").

  Per-user: installs under %LOCALAPPDATA%\Programs\Suveren with NO admin
  rights and NO UAC prompt — required because the target is a company laptop
  where the signed-in user has none. IT signs this with its own certificate
  (see build-signed.ps1) and distributes it via Intune in "user context".

  Scope="perUserOrMachine", not the stricter "perUser": WiX's own docs for
  the <Files> harvesting element below warn that strictly per-user packages
  generate components that fail ICE validation. "OrMachine" still DEFAULTS
  to a per-user install (this package never sets ALLUSERS) — it only adds
  the possibility of a per-machine install for someone who explicitly asks
  for one, which nothing here does.

  Installs files and a Start Menu shortcut — no HKCU\Environment writes.
  Starting the gateway and registering autostart go through the EXISTING
  `suveren-gateway service install` and detached-start CLI code paths, run
  from the launcher, which sets its own env scoped to just the gateway's
  process tree (see launcher.cmd and the InstallMarkerComponent note below
  for why this isn't done via HKCU\Environment).

  Two UNINSTALL-ONLY custom actions exist (see "Uninstall cleanup" below):
  stopping a running gateway so its own files aren't locked when Windows
  Installer tries to remove them, and deleting the scheduled task. IT
  uninstalls via Intune/msiexec directly, never through our CLI — without
  these, `msiexec /x` on its own left the scheduled task registered forever
  (confirmed on windows-latest CI), still pointing at a now-deleted launcher.

  UpgradeCode is FIXED — never change it across releases, or Windows treats
  every version as an unrelated product instead of an upgrade (orphaned old
  installs, no cleanup, no single "Suveren Gateway" entry in Settings).
-->
<!-- Valid gateway settings (PORT / MCP_PORT / DATA_DIR, each optional — empty means
     the default). Used by the launch condition (silent installs) and by the settings
     page's Next button. Ports: 1024–65535, different from each other, also against the
     OTHER one's default; data folder: a full path (drive or UNC). The gateway checks the
     same rules again at every start (bundle/lib/install-settings.mjs) — this only stops
     an obvious typo before anything is installed. -->
<?define SettingsValid = (NOT PORT OR (PORT >= 1024 AND PORT <= 65535)) AND (NOT MCP_PORT OR (MCP_PORT >= 1024 AND MCP_PORT <= 65535)) AND (NOT PORT OR NOT MCP_PORT OR PORT <> MCP_PORT) AND (NOT PORT OR MCP_PORT OR PORT <> 3430) AND (NOT MCP_PORT OR PORT OR MCP_PORT <> 3400) AND (NOT DATA_DIR OR DATA_DIR >< ":\" OR DATA_DIR << "\\") ?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
    Name="Suveren Gateway"
    Manufacturer="Suveren"
    Version="$(var.ProductVersion)"
    UpgradeCode="ab6e0a2e-6b3f-4c2a-9b7a-9b7b7e2a3b10"
    Language="1033"
    Scope="perUserOrMachine"
    Compressed="yes">

    <SummaryInformation
      Description="Suveren Gateway — Human Agency Protocol gateway (unsigned; sign and distribute via your own certificate)"
      Manufacturer="Suveren" />

    <!-- A newer version already installed refuses an older one outright,
         rather than silently downgrading files a newer connector set
         depends on.

         AllowSameVersionUpgrades="yes": without it, re-installing the EXACT
         same ProductVersion falls into neither the upgrade nor the downgrade
         range, so Windows Installer treats it as an unrelated product —
         observed for real (a test build sharing its version with an already-
         installed release registered as a SECOND product instead of
         upgrading it, part of a stuck-install investigation on a Windows 11
         VM). Harmless the rest of the time: it only matters when the two
         versions are literally identical. -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of Suveren Gateway is already installed. Uninstall it first to install this older version."
      Schedule="afterInstallInitialize"
      AllowSameVersionUpgrades="yes" />

    <MediaTemplate EmbedCab="yes" />

    <!-- Per-user install root: %LOCALAPPDATA%\Programs\Suveren -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsRootFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="Suveren" />
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="SuverenMenuFolder" Name="Suveren" />
    </StandardDirectory>

    <!-- The payload: official Node win-x64, the gateway bundle, and every
         pinned connector — thousands of files from build-payload.mjs.
         Harvested by glob (WiX v5's built-in <Files> globbing) rather than
         hand-listed or run through heat.exe separately.

         ONE <Files> element covering the whole payload tree, not one per
         subdirectory (node\, gateway\, integrations\): WiX derives each
         generated File/Component Id from the path relative to the <Files>
         element's OWN Include base, so three separate globs can each
         independently produce the same relative path (e.g. two unrelated
         node_modules/<pkg>/package.json at the same depth) and collide —
         error WIX0091 "Duplicate File ... found", hit for real on the
         windows-latest CI runner. One glob over PayloadDir\** makes every
         relative path unique by construction, and still reproduces the
         exact node\ / gateway\ / integrations\ subtree layout underneath
         INSTALLFOLDER that launcher.cmd expects. -->
    <ComponentGroup Id="PayloadFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PayloadDir)\**" />
    </ComponentGroup>

    <!-- The launcher — see bundle/windows/launcher.cmd's own doc comment. -->
    <Component Id="LauncherComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1001">
      <File Id="LauncherCmd" Source="$(var.LauncherSource)" Name="suveren-gateway.cmd" KeyPath="yes" />
    </Component>

    <!-- Start Menu entry that opens the gateway UI (starts it if needed,
         registering autostart on this first use — see launcher.cmd). -->
    <Component Id="StartMenuShortcutComponent" Directory="SuverenMenuFolder" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1002">
      <Shortcut
        Id="StartMenuShortcut"
        Name="Suveren Gateway"
        Description="Open the Suveren gateway"
        Target="[WindowsFolder]System32\conhost.exe"
        Arguments="--headless cmd.exe /c &quot;&quot;[#LauncherCmd]&quot; open-ui&quot;"
        Show="minimized"
        Icon="SuverenIcon"
        WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="RemoveSuverenMenuFolder" Directory="SuverenMenuFolder" On="uninstall" />
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Deliberately NOT writing anything to HKCU\Environment. An earlier
         version of this installer set SUVEREN_INSTALL_METHOD, SUVEREN_
         OFFLINE, SUVEREN_INTEGRATIONS_DIR and a PATH prepend for the bundled
         node there, reasoning that the Task Scheduler ONLOGON task (which
         carries no environment block of its own — see autostart-templates.
         mjs's buildWindowsTaskXml doc comment) needed it at the next logon.
         That is ACCOUNT-WIDE, not scoped to the gateway: it would shadow a
         developer's own Node (say, 24 or 25) with the bundled 22 for EVERY
         program that account runs, and force every OTHER gateway install
         under the same Windows user (an npm install, a dev checkout) into
         offline+managed mode too — unacceptable for an IT deploy to many
         people who may use Node themselves.

         Instead, `service install` (bundle/bin/suveren-gateway.js) routes
         the scheduled task through THIS launcher (SUVEREN_LAUNCHER env var,
         set by launcher.cmd before it forwards to the CLI) rather than
         node.exe+server.js directly — the launcher sets the same variables
         itself, scoped to just the one process tree it starts. See
         launcher.cmd's `run` subcommand and buildWindowsTaskXml's
         command/args override.

         This component now only carries a harmless per-user marker so the
         Feature below has something to reference; it does nothing at
         runtime. -->
    <Component Id="InstallMarkerComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1003">
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
    </Component>

    <!-- Gateway settings: port, MCP port, data folder.

         Set on the command line for a silent (Intune) install —
           msiexec /i suveren-gateway.msi /qn PORT=3500 MCP_PORT=3530 DATA_DIR="D:\Suveren"
         — or on the settings page of a double-click install. Each is optional; empty
         means the default (3400 / 3430 / %USERPROFILE%\.suveren).

         Saved to HKCU\Software\Suveren\Gateway (Port, McpPort, DataDir), which is where
         the gateway reads them at every start — including the login task, which has no
         environment of its own (bundle/lib/install-settings.mjs). `suveren-gateway config
         set port|mcp-port|data-dir` writes the same values.

         Remembered across upgrades: the SAVED_* searches read what is there now, and
         RememberX copies it into X unless X was given on the command line. Without this an
         upgrade with no properties would remove the old values (the old product's
         components are removed first) and silently move the gateway back to the defaults
         and an empty data folder.

         Each value is its own conditional component: an empty property installs nothing,
         so no empty value is ever written. A plain uninstall removes them (the data folder
         itself is never touched). -->
    <Property Id="PORT" Secure="yes" />
    <Property Id="MCP_PORT" Secure="yes" />
    <Property Id="DATA_DIR" Secure="yes" />
    <Property Id="SAVED_PORT">
      <RegistrySearch Id="SavedPortSearch" Root="HKCU" Key="Software\Suveren\Gateway" Name="Port" Type="raw" />
    </Property>
    <Property Id="SAVED_MCP_PORT">
      <RegistrySearch Id="SavedMcpPortSearch" Root="HKCU" Key="Software\Suveren\Gateway" Name="McpPort" Type="raw" />
    </Property>
    <Property Id="SAVED_DATA_DIR">
      <RegistrySearch Id="SavedDataDirSearch" Root="HKCU" Key="Software\Suveren\Gateway" Name="DataDir" Type="raw" />
    </Property>
    <SetProperty Id="PORT" Action="RememberPort" Value="[SAVED_PORT]" After="AppSearch" Condition="NOT PORT AND SAVED_PORT" />
    <SetProperty Id="MCP_PORT" Action="RememberMcpPort" Value="[SAVED_MCP_PORT]" After="AppSearch" Condition="NOT MCP_PORT AND SAVED_MCP_PORT" />
    <SetProperty Id="DATA_DIR" Action="RememberDataDir" Value="[SAVED_DATA_DIR]" After="AppSearch" Condition="NOT DATA_DIR AND SAVED_DATA_DIR" />
    <!-- Double-click install only: show the defaults in the fields instead of empty boxes. -->
    <SetProperty Id="PORT" Action="DefaultPort" Value="3400" After="RememberPort" Sequence="ui" Condition="NOT PORT" />
    <SetProperty Id="MCP_PORT" Action="DefaultMcpPort" Value="3430" After="RememberMcpPort" Sequence="ui" Condition="NOT MCP_PORT" />
    <SetProperty Id="DATA_DIR" Action="DefaultDataDir" Value="[%USERPROFILE]\.suveren" After="RememberDataDir" Sequence="ui" Condition="NOT DATA_DIR" />

    <Launch
      Condition="Installed OR ($(var.SettingsValid))"
      Message="Invalid gateway settings. PORT and MCP_PORT must be numbers from 1024 to 65535 and differ from each other (defaults 3400 and 3430); DATA_DIR must be a full path such as D:\Suveren." />

    <Component Id="PortSettingComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1004" Condition="PORT">
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="Port" Type="string" Value="[PORT]" KeyPath="yes" />
    </Component>
    <Component Id="McpPortSettingComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1005" Condition="MCP_PORT">
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="McpPort" Type="string" Value="[MCP_PORT]" KeyPath="yes" />
    </Component>
    <Component Id="DataDirSettingComponent" Directory="INSTALLFOLDER" Guid="2c6e9b5a-4f1a-4a2d-8a5a-7e6b7c9a1006" Condition="DATA_DIR">
      <RegistryValue Root="HKCU" Key="Software\Suveren\Gateway" Name="DataDir" Type="string" Value="[DATA_DIR]" KeyPath="yes" />
    </Component>

    <Feature Id="Main" Title="Suveren Gateway" Level="1">
      <ComponentGroupRef Id="PayloadFiles" />
      <ComponentRef Id="LauncherComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="InstallMarkerComponent" />
      <ComponentRef Id="PortSettingComponent" />
      <ComponentRef Id="McpPortSettingComponent" />
      <ComponentRef Id="DataDirSettingComponent" />
    </Feature>

    <!-- Interactive (double-click) install only: WixUI_Minimal — welcome,
         progress, exit, nothing else (no EULA page; this installer is
         unsigned freeware-style, matching the rest of the "IT verifies and
         signs it" story). A SILENT install (`/qn`, the real Intune path)
         never shows ANY of this — StartGatewayAfterInstall above already
         brings the gateway up headlessly regardless of UI, which is the
         path that actually matters for a company deployment.

         ExitDialog's "OptionalCheckBox" control is BUILT INTO WixUI's own
         ExitDialog.wxs (part of WixToolset.UI.wixext — see its source);
         setting these two properties is what makes it appear, checked by
         default, worded for this product. "NOT Installed" (baked into the
         control's own ShowCondition, and repeated in the Publish condition
         below) is WixUI's standard guard against showing this on a repair
         — not relevant to a product with no repair UI exposed here, kept
         for correctness anyway.

         Order="10" on the Publish below — well before WixUI_Minimal's own
         `Finish -> EndDialog` at Order="999" — runs OUR action first, then
         lets the dialog close normally. -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Suveren Gateway" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <!-- WixUI_Minimal_X64, not the bare WixUI_Minimal: the UI extension's
         own WixUI_Minimal.wxs defines the externally-usable entry point
         per architecture (WixUI_Minimal_X86/_X64/_A64, each a thin wrapper
         that references the shared, library-private "file WixUI_Minimal").
         The bare Id is scoped "file"-private to the extension's own
         compiled object and isn't directly referenceable from here — "error
         WIX0094: The identifier 'WixUI:WixUI_Minimal' is inaccessible due
         to its protection level", confirmed for real on windows-latest.
         Matches this package's own -arch x64. -->
    <!-- Licence page: the repository's MIT LICENSE word for word plus a third-party note,
         generated by bundle/windows/license-rtf.mjs (a test keeps it in sync). Without
         this WixUI shows its own "Lorem ipsum" placeholder. -->
    <WixVariable Id="WixUILicenseRtf" Value="$(sys.SOURCEFILEDIR)License.rtf" />
    <!-- Suveren look instead of the toolkit's default red artwork (signed off 2026-10-05);
         generated by bundle/windows/make-graphics.mjs from the gateway's mark. -->
    <WixVariable Id="WixUIDialogBmp" Value="$(sys.SOURCEFILEDIR)dialog.bmp" />
    <WixVariable Id="WixUIBannerBmp" Value="$(sys.SOURCEFILEDIR)banner.bmp" />
    <Icon Id="SuverenIcon" SourceFile="$(sys.SOURCEFILEDIR)suveren.ico" />
    <Property Id="ARPPRODUCTICON" Value="SuverenIcon" />
    <!-- Was WixUI_Minimal_X64 (one page: licence + Install). Now WixUI_InstallDir's page
         flow with our settings page in place of the install-folder page (the install
         folder stays fixed — per-user, no admin):
           Welcome → Licence → Gateway settings → Ready to install.
         Copied from WiX 5.0.2's own WixUI_InstallDir.wxs (src/ext/UI/wixlib), minus the
         folder-browse pieces. A silent install (/qn) shows none of this. -->
    <UI Id="SuverenUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />

      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchGatewayAfterInstall" Order="10" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="LicenseAgreementDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="LicenseAgreementDlg" Control="Print" Event="DoAction" Value="WixUIPrintEula_X64" />
      <Publish Dialog="LicenseAgreementDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="LicenseAgreementDlg" Control="Next" Event="NewDialog" Value="SuverenSettingsDlg" Condition="LicenseAccepted = &quot;1&quot;" />

      <Publish Dialog="SuverenSettingsDlg" Control="Back" Event="NewDialog" Value="LicenseAgreementDlg" />
      <Publish Dialog="SuverenSettingsDlg" Control="Next" Property="SUVEREN_SETTINGS_CHECKED" Value="1" Order="1" />
      <Publish Dialog="SuverenSettingsDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="2" Condition="$(var.SettingsValid)" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="SuverenSettingsDlg" Order="1" Condition="NOT Installed" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Property Id="ARPNOMODIFY" Value="1" />

      <!-- The settings page. Same frame as WiX's own InstallDirDlg (banner, lines, buttons). -->
      <Dialog Id="SuverenSettingsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)" />
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>

        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Where the gateway listens and keeps its data. The defaults suit most people." />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Gateway settings" />
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />

        <Control Id="PortLabel" Type="Text" X="20" Y="54" Width="330" Height="12" NoPrefix="yes" Text="Port for the gateway in your browser (default 3400):" />
        <Control Id="PortEdit" Type="Edit" X="20" Y="67" Width="60" Height="17" Property="PORT" Text="{5}" />
        <Control Id="McpPortLabel" Type="Text" X="20" Y="90" Width="330" Height="12" NoPrefix="yes" Text="Port AI assistants connect to, MCP (default 3430):" />
        <Control Id="McpPortEdit" Type="Edit" X="20" Y="103" Width="60" Height="17" Property="MCP_PORT" Text="{5}" />
        <Control Id="DataDirLabel" Type="Text" X="20" Y="126" Width="330" Height="12" NoPrefix="yes" Text="Folder for your data (vault, mandates, logs):" />
        <Control Id="DataDirEdit" Type="Edit" X="20" Y="139" Width="330" Height="17" Property="DATA_DIR" Text="{260}" />
        <Control Id="Hint" Type="Text" X="20" Y="162" Width="330" Height="30" NoPrefix="yes" Text="Ports must be from 1024 to 65535 and differ from each other. The folder must be a full path, for example D:\Suveren. Changing the folder later does not move data that is already there." />
        <Control Id="Invalid" Type="Text" X="20" Y="200" Width="330" Height="24" NoPrefix="yes" Hidden="yes" Text="{\WixUI_Font_Title}Please check the values above: a port or the folder is not valid." ShowCondition="SUVEREN_SETTINGS_CHECKED AND NOT ($(var.SettingsValid))" HideCondition="NOT SUVEREN_SETTINGS_CHECKED OR ($(var.SettingsValid))" />
      </Dialog>
    </UI>
    <UIRef Id="WixUI_Common" />

    <!-- Runs ONLY from the ExitDialog checkbox above (immediate, not part of
         InstallExecuteSequence — this is a UI-sequence action, fired after
         the install has already finished and StartGatewayAfterInstall has
         already brought the gateway up headlessly). Its ONE job beyond that
         is the part a silent install must never do: open a browser tab.
         `cmd.exe /c start /min "" "..."` — `start`'s own empty-title
         placeholder (`""`) is required before a quoted target path, the
         classic cmd.exe `start` gotcha, and `/min` matches the Start Menu
         shortcut's own Show="minimized" (no console window pops up — see
         PR #47). Return="asyncNoWait": the MSI UI thread must not block on
         a process that opens a browser and keeps a gateway running
         indefinitely. Calls `open-ui` (not `run`): the Start Menu shortcut
         already does exactly this, including opening the browser — the
         correct behaviour for a human who just chose "Launch" on a dialog
         they're looking at, unlike the silent/headless commit action. -->
    <!-- Headless, like the Start-menu entry and the login task: `cmd /c start "" x.cmd`
         runs the batch file with `cmd /K`, which kept a (minimized) console window open for
         good after Finish (caught by CI's window check). conhost.exe headless + `cmd /c`
         runs open-ui with no window; only the browser it opens appears. -->
    <CustomAction
      Id="LaunchGatewayAfterInstall"
      Directory="INSTALLFOLDER"
      ExeCommand="conhost.exe --headless cmd.exe /c &quot;&quot;[INSTALLFOLDER]suveren-gateway.cmd&quot; open-ui&quot;"
      Execute="immediate"
      Return="asyncNoWait"
      Impersonate="yes" />

    <!-- Stop / start custom actions (bundle/windows/stop-gateway.ps1 is the readable
         version of the stop logic, for IT to run by hand).

         StopGateway — IMMEDIATE, Before="InstallValidate", on every install, upgrade and
         uninstall — except inside the OLD version's removal during an upgrade
         (UPGRADINGPRODUCTCODE): the new package already stopped everything, and running it
         twice cost ~45 s on ARM. Get-Process (not Get-CimInstance) because the CIM query
         alone took ~45 s under x64 emulation on Windows 11 ARM. It must run before anything touches the gateway's files: InstallValidate
         (the files-in-use check), RemoveExistingProducts (with MajorUpgrade
         Schedule="afterInstallInitialize" the OLD version is removed right after
         InstallInitialize — long before RemoveFiles, which is why the earlier
         Before="RemoveFiles" anchor still hung), and file removal on uninstall. Only an
         immediate action may be scheduled that early; deferred ones fail with 2762. It ends
         the scheduled task's run and kills every node.exe whose executable lives under
         INSTALLFOLDER — that covers both a task-started gateway (the normal case, which the
         CLI's own `stop` refuses: "running under the login service") and a detached one.
         Running it in the NEW package also fixes upgrading FROM releases that have no stop
         logic at all. Harmless when nothing runs. Inlined via -Command because on a fresh
         install or an upgrade from an old release no script of ours exists yet.

         RemoveScheduledTaskOnUninstall — plain uninstall only (REMOVE="ALL" AND NOT
         UPGRADINGPRODUCTCODE): an upgrade keeps the task, whose launcher path is the same
         across versions.

         StartGatewayAfterInstall — COMMIT action (runs only after the whole transaction
         succeeded), scheduled Before="InstallFinalize" (After="InstallFinalize" failed every
         install with 2762). Through the launcher it first unpacks runtime.zip (`prepare`),
         then registers autostart (`service install`, idempotent) and runs the task, so the gateway is up after a fresh install and after an upgrade — silently, no
         browser (the interactive Finish checkbox opens the browser separately).

         All Return="ignore": a gateway that is not running or a missing task must never fail
         the install. -->
    <CustomAction
      Id="StopGateway"
      Directory="INSTALLFOLDER"
      ExeCommand="powershell.exe -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;$ErrorActionPreference='SilentlyContinue'; schtasks.exe /End /TN Suveren 2&gt;$null; $p=('[INSTALLFOLDER]').TrimEnd('\').ToLower()+'\'; Get-Process -Name node | Where-Object { $_.Path -and $_.Path.ToLower().StartsWith($p) } | Stop-Process -Force&quot;"
      Execute="immediate"
      Return="ignore" />

    <CustomAction
      Id="RemoveScheduledTaskOnUninstall"
      Directory="INSTALLFOLDER"
      ExeCommand="schtasks.exe /Delete /TN Suveren /F"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <!-- runtime.zip is unpacked by the launcher (`prepare`) into integrations\ and
         gateway\node_modules\, so Windows Installer does not track those files —
         remove them on a plain uninstall (an upgrade keeps them; the new launcher
         re-unpacks when runtime.stamp changes). -->
    <CustomAction
      Id="RemoveRuntimeOnUninstall"
      Directory="INSTALLFOLDER"
      ExeCommand="cmd.exe /c rmdir /s /q &quot;[INSTALLFOLDER]integrations&quot; &amp; rmdir /s /q &quot;[INSTALLFOLDER]gateway\node_modules&quot; &amp; rmdir /s /q &quot;[INSTALLFOLDER]runtime.lock&quot; &amp; del /q &quot;[INSTALLFOLDER]runtime.extracted&quot;"
      Execute="deferred"
      Impersonate="yes"
      Return="ignore" />

    <CustomAction
      Id="StartGatewayAfterInstall"
      Directory="INSTALLFOLDER"
      ExeCommand="cmd.exe /c &quot;[INSTALLFOLDER]suveren-gateway.cmd&quot; service install &amp; schtasks.exe /Run /TN Suveren"
      Execute="commit"
      Impersonate="yes"
      Return="ignore" />

    <InstallExecuteSequence>
      <!-- Immediate, before InstallValidate: no gateway process may hold files when Windows Installer
           checks for files in use, removes the old version (major upgrade, RemoveExistingProducts
           afterInstallInitialize) or removes files on uninstall. An immediate action is the only kind
           allowed outside InstallInitialize..InstallFinalize (deferred ones there fail with 2762). -->
      <Custom Action="StopGateway" Before="InstallValidate" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveScheduledTaskOnUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RemoveRuntimeOnUninstall" Before="RemoveFiles" Condition="REMOVE=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
      <!-- Commit: runs only once the whole transaction has succeeded, but must be SCHEDULED before
           InstallFinalize (After="InstallFinalize" failed every install with error 2762). -->
      <Custom Action="StartGatewayAfterInstall" Before="InstallFinalize" Condition="NOT REMOVE=&quot;ALL&quot;" />
    </InstallExecuteSequence>

  </Package>
</Wix>
