{
  "id": "crm",
  "name": "CRM",
  "version": "1.0.0",
  "description": "Customer relationship management — contacts, activities, deals, tasks",
  "icon": "users",
  "profile": "customers",
  "npmPackage": "@humanagencyp/crm-mcp",
  "mcp": {
    "command": "crm-mcp",
    "args": []
  },
  "credentials": {
    "fields": [
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      },
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs an adapter for your CRM",
        "optional": true
      }
    ],
    "envMapping": {
      "DATABASE_URL": "databaseUrl",
      "CRM_MODE": "mode"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "personalDefault": true,
  "oauth": null,
  "toolGating": {
    "default": {
      "executionMapping": {},
      "staticExecution": {
        "contact_type": "customer"
      }
    },
    "overrides": {
      "create_contact": {
        "executionMapping": {
          "type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact created"
      },
      "update_contact": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        },
        "actionLabel": "Contact updated"
      },
      "delete_contact": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "delete"
        },
        "actionLabel": "Contact deleted"
      },
      "log_activity": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        }
      },
      "create_deal": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        }
      },
      "update_deal": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        }
      },
      "create_task": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        }
      },
      "complete_task": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        }
      },
      "find_contacts": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_timeline": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_pipeline": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_tasks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "export_crm": {
        "category": "read",
        "boundField": "export_access",
        "requiredValue": "allowed"
      },
      "load_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "setup"
        },
        "actionLabel": "Test data loaded"
      }
    }
  },
  "templates": [
    {
      "name": "Browse & Log",
      "description": "Search contacts, view pipeline and timeline, log activities. No creates or deletes.",
      "risk": "low",
      "mode": "automatic",
      "bounds": {
        "read_access": "unlimited",
        "write_daily_max": "50",
        "delete_daily_max": "0",
        "setup_daily_max": "0"
      },
      "context": {
        "contact_type": "customer,lead,partner,vendor"
      },
      "intent": "Allow the agent to browse CRM data and log activities. Read and log only — no creating, editing, or deleting records.",
      "ttl": 2592000,
      "tags": [
        "read + log",
        "no deletes"
      ]
    },
    {
      "name": "Full CRM with Review",
      "description": "Create contacts, deals, and tasks. Update and delete records. Every write requires approval.",
      "risk": "high",
      "mode": "review",
      "bounds": {
        "read_access": "unlimited",
        "write_daily_max": "50",
        "delete_daily_max": "10",
        "setup_daily_max": "0"
      },
      "context": {
        "contact_type": "customer,lead,partner,vendor"
      },
      "intent": "Full CRM management — create, update, and delete contacts, deals, and tasks. Every write action requires my review before execution.",
      "ttl": 2592000,
      "tags": [
        "50 writes/day",
        "10 deletes/day",
        "review mode"
      ]
    },
    {
      "name": "Load test data (with approval)",
      "description": "Load a simulation package (customers and optional contacts) into the simulated CRM, for setting up a three-week test. No browsing, writing, or deleting — this template grants nothing but the one-time test-data load, and it still requires your approval.",
      "risk": "high",
      "mode": "review",
      "bounds": {
        "read_access": "none",
        "write_daily_max": "0",
        "delete_daily_max": "0",
        "setup_daily_max": "1"
      },
      "context": {
        "contact_type": "customer"
      },
      "intent": "Allow the agent to load one simulation package of test data into the simulated CRM, for my review before it happens. No other CRM action is granted by this mandate — set up test data separately from the mandate the agent uses for its actual work.",
      "ttl": 2592000,
      "tags": [
        "setup only",
        "review mode",
        "1 load"
      ]
    }
  ],
  "setupHint": "No configuration needed — works out of the box.",
  "setupGuide": [
    {
      "title": "Ready to use",
      "description": "The CRM stores data locally on your machine. No external account or API key needed."
    },
    {
      "title": "Optional: use a shared database",
      "description": "For team use, provide a PostgreSQL connection string in the Database URL field. Otherwise, leave it empty to use local SQLite storage."
    }
  ]
}
