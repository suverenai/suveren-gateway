{
  "id": "crm",
  "name": "CRM",
  "version": "1.0.0",
  "description": "Customer relationship management — contacts, activities, deals, tasks",
  "icon": "users",
  "profile": "customers",
  "npmPackage": "@humanagencyp/crm-mcp",
  "npmVersion": "1.5.0",
  "mcp": {
    "command": "crm-mcp",
    "args": []
  },
  "credentials": {
    "fields": [
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      },
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs an adapter for your CRM",
        "optional": true
      }
    ],
    "envMapping": {
      "DATABASE_URL": "databaseUrl",
      "CRM_MODE": "mode"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "personalDefault": true,
  "oauth": null,
  "context": {
    "sources": {
      "activity": {
        "read": { "tool": "get_activity", "args": { "id": "$id" } },
        "title": "summary",
        "author": "created_by",
        "at": "date",
        "body": "detail"
      }
    },
    "history": {
      "byKey": ["email_domain", "email"],
      "read": { "tool": "get_timeline", "args": { "$keyType": "$key", "since": "$since", "limit": "$limit" } },
      "limit": 5,
      "maxAgeDays": 14,
      "item": {
        "kind": "activity",
        "title": "summary",
        "body": "detail",
        "at": "date",
        "author": "created_by",
        "type": "type",
        "ticket": "ticket_id"
      }
    }
  },
  "toolGating": {
    "default": {
      "executionMapping": {
        "contact_type": "contact_type"
      },
      "staticExecution": {}
    },
    "overrides": {
      "create_contact": {
        "summary": "Create contact {name}[ ({company})]",
        "executionMapping": {
          "type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact created",
        "contextKeys": { "email": "email" },
        "preview": [
          { "tool": "find_contacts", "args": { "query": "email" } }
        ],
        "display": {
          "order": ["name", "email", "company", "role", "type", "stage", "tags", "notes"],
          "labels": {
            "name": "Name", "email": "Email", "company": "Company", "role": "Role",
            "type": "Type", "stage": "Stage", "tags": "Tags", "notes": "Notes"
          }
        }
      },
      "update_contact": {
        "summary": "Update contact {name,id}",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact updated",
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "id",
            "revision": "revision"
          },
          "version": {
            "arg": "revision",
            "field": "revision"
          },
          "fields": [
            "name",
            "company",
            "type",
            "stage",
            "email",
            "archived",
            "revision"
          ]
        }
      },
      "delete_contact": {
        "summary": "Archive a {contact_type} contact",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "delete"
        },
        "actionLabel": "Contact archived",
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "id",
            "revision": "revision"
          },
          "version": {
            "arg": "revision",
            "field": "revision"
          },
          "fields": [
            "name",
            "company",
            "type",
            "stage",
            "email",
            "archived",
            "revision"
          ]
        }
      },
      "restore_contact": {
        "summary": "Restore a {contact_type} contact",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "delete"
        },
        "actionLabel": "Contact restored",
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "id",
            "revision": "revision"
          },
          "version": {
            "arg": "revision",
            "field": "revision"
          },
          "fields": [
            "name",
            "company",
            "type",
            "stage",
            "email",
            "archived",
            "revision"
          ]
        }
      },
      "convert_contact": {
        "summary": "Convert a contact to {to_type}",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact type changed",
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "id",
            "revision": "revision"
          },
          "version": {
            "arg": "revision",
            "field": "revision"
          },
          "fields": [
            "name",
            "company",
            "type",
            "stage",
            "email",
            "archived",
            "revision"
          ]
        }
      },
      "log_activity": {
        "summary": "Log {type}: {summary|short}",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "contact_id"
          },
          "fields": [
            "name",
            "company",
            "type"
          ]
        }
      },
      "create_deal": {
        "summary": "Create deal: {title|short}[ — {value|money}]",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "contact_id"
          },
          "fields": [
            "name",
            "company",
            "type"
          ]
        }
      },
      "update_deal": {
        "summary": "Update deal[: {title|short}][ — {value|money}]",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "preview": {
          "tool": "get_deal",
          "args": {
            "id": "id",
            "revision": "revision"
          },
          "version": {
            "arg": "revision",
            "field": "revision"
          },
          "fields": [
            "title",
            "value",
            "currency",
            "stage",
            "expected_close",
            "contact_id",
            "revision"
          ]
        }
      },
      "create_task": {
        "summary": "Create task: {title|short}[ (due {due_date|date})]",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "preview": {
          "tool": "get_contact",
          "args": {
            "id": "contact_id"
          },
          "fields": [
            "name",
            "company",
            "type"
          ]
        }
      },
      "complete_task": {
        "summary": "Complete a task",
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "preview": {
          "tool": "get_task",
          "args": {
            "id": "id",
            "revision": "revision"
          },
          "version": {
            "arg": "revision",
            "field": "revision"
          },
          "fields": [
            "title",
            "status",
            "due_date",
            "contact_id",
            "revision"
          ]
        }
      },
      "find_contacts": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_contact": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_timeline": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_activity": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_pipeline": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_deal": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_tasks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_task": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "export_crm": {
        "category": "read",
        "boundField": "export_access",
        "requiredValue": "allowed"
      },
      "load_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "setup"
        },
        "actionLabel": "Test data loaded",
        "hideUnlessAuthorized": true,
        "simulationOnly": true
      },
      "clear_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "setup"
        },
        "actionLabel": "Test data cleared",
        "hideUnlessAuthorized": true,
        "simulationOnly": true
      }
    }
  },
  "setupHint": "No configuration needed — works out of the box.",
  "setupGuide": [
    {
      "title": "Ready to use",
      "description": "The CRM stores data locally on your machine. No external account or API key needed."
    },
    {
      "title": "Optional: use a shared database",
      "description": "For team use, provide a PostgreSQL connection string in the Database URL field. Otherwise, leave it empty to use local SQLite storage."
    }
  ]
}
