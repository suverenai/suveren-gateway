{
  "id": "crm",
  "name": "CRM",
  "version": "1.0.0",
  "description": "Customer relationship management — contacts, activities, deals, tasks",
  "icon": "users",
  "profile": "customers",
  "npmPackage": "@humanagencyp/crm-mcp",
  "npmVersion": "1.3.0",
  "mcp": {
    "command": "crm-mcp",
    "args": []
  },
  "credentials": {
    "fields": [
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      },
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs an adapter for your CRM",
        "optional": true
      }
    ],
    "envMapping": {
      "DATABASE_URL": "databaseUrl",
      "CRM_MODE": "mode"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "personalDefault": true,
  "oauth": null,
  "toolGating": {
    "default": {
      "executionMapping": {
        "contact_type": "contact_type"
      },
      "staticExecution": {}
    },
    "overrides": {
      "create_contact": {
        "executionMapping": {
          "type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact created"
      },
      "update_contact": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact updated"
      },
      "delete_contact": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "delete"
        },
        "actionLabel": "Contact archived"
      },
      "restore_contact": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "delete"
        },
        "actionLabel": "Contact restored"
      },
      "convert_contact": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        },
        "actionLabel": "Contact type changed"
      },
      "log_activity": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        }
      },
      "create_deal": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        }
      },
      "update_deal": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        }
      },
      "create_task": {
        "executionMapping": {
          "contact_type": "contact_type"
        },
        "staticExecution": {
          "action_type": "write"
        }
      },
      "complete_task": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "write"
        }
      },
      "find_contacts": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_contact": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_timeline": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_pipeline": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_deal": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_tasks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_task": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "export_crm": {
        "category": "read",
        "boundField": "export_access",
        "requiredValue": "allowed"
      },
      "load_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "setup"
        },
        "actionLabel": "Test data loaded",
        "hideUnlessAuthorized": true
      },
      "clear_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "contact_type": "customer",
          "action_type": "setup"
        },
        "actionLabel": "Test data cleared",
        "hideUnlessAuthorized": true
      }
    }
  },
  "setupHint": "No configuration needed — works out of the box.",
  "setupGuide": [
    {
      "title": "Ready to use",
      "description": "The CRM stores data locally on your machine. No external account or API key needed."
    },
    {
      "title": "Optional: use a shared database",
      "description": "For team use, provide a PostgreSQL connection string in the Database URL field. Otherwise, leave it empty to use local SQLite storage."
    }
  ]
}
