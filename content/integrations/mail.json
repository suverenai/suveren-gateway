{
  "id": "mail",
  "name": "Email (simulation)",
  "version": "1.0.0",
  "description": "Simulated inbox for testing an agent's email replies — nothing leaves the laptop",
  "icon": "mail",
  "profile": "email",
  "npmPackage": "@humanagencyp/email-mcp",
  "npmVersion": "0.4.0",
  "readPolicy": {
    "defaultAgeDays": 30
  },
  "mcp": {
    "command": "email-mcp",
    "args": []
  },
  "credentials": {
    "fields": [
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs a mailbox adapter",
        "optional": true
      },
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      }
    ],
    "envMapping": {
      "EMAIL_MODE": "mode",
      "DATABASE_URL": "databaseUrl"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "modeLabels": {
    "simulation": "Test mailbox"
  },
  "personalDefault": false,
  "oauth": null,
  "attachments": {
    "transport": "field",
    "arg": "attachments"
  },
  "context": {
    "sources": {
      "message": {
        "read": { "tool": "get_message", "args": { "id": "$id" } },
        "keys": { "email": "from.email" },
        "title": "subject",
        "author": "from.name",
        "at": "received_at",
        "body": "body",
        "chain": { "field": "in_reply_to", "max": 5 }
      }
    }
  },
  "toolGating": {
    "default": {
      "executionMapping": {},
      "staticExecution": {}
    },
    "overrides": {
      "list_messages": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited",
        "read": {
          "ageField": "read_age_days"
        }
      },
      "get_message": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited",
        "read": {
          "ageField": "read_age_days",
          "resultDatePath": "received_at"
        }
      },
      "send_message": {
        "summary": "Email to {to|list}: {subject|short}",
        "executionMapping": {
          "to": [
            {
              "field": "recipient_count",
              "transform": "length"
            },
            {
              "field": "allowed_recipients",
              "transform": "join"
            },
            {
              "field": "allowed_domains",
              "transform": "join_domains"
            }
          ]
        },
        "staticExecution": {
          "action_type": "send"
        },
        "actionLabel": "Email sent",
        "sourceFromArg": { "kind": "message", "arg": "in_reply_to" },
        "contextKeys": { "email": "to" },
        "attachmentsArg": "attachments",
        "insertFields": ["body"],
        "display": { "aiText": "body" }
      },
      "load_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "action_type": "setup"
        },
        "actionLabel": "Test data loaded",
        "hideUnlessAuthorized": true,
        "simulationOnly": true
      },
      "clear_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "action_type": "setup"
        },
        "actionLabel": "Test data cleared",
        "hideUnlessAuthorized": true,
        "simulationOnly": true
      }
    }
  },
  "setupHint": "No configuration needed — works out of the box, in simulation mode.",
  "setupGuide": [
    {
      "title": "Ready to use",
      "description": "This connector stores a simulated inbox locally on your machine. Nothing is sent anywhere until you load test data with a separate, reviewed setup mandate."
    },
    {
      "title": "Optional: use a shared database",
      "description": "For team use, provide a PostgreSQL connection string in the Database URL field. Otherwise, leave it empty to use local SQLite storage."
    }
  ]
}
