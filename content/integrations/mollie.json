{
  "id": "mollie",
  "name": "Mollie",
  "version": "1.0.0",
  "description": "Payment links, payments and payment customers — profile: Payments (charge@0.7). Invoices come from the ERP; Mollie never emails customers.",
  "icon": "card",
  "profile": "charge",
  "npmPackage": "mcp-remote",
  "npmVersion": "0.14.3",
  "mcp": {
    "command": "mcp-remote",
    "args": [
      "https://mcp.mollie.com/mcp",
      "--header",
      "Authorization: Bearer ${MOLLIE_ACCESS_TOKEN}"
    ]
  },
  "credentials": {
    "fields": [
      {
        "key": "accessToken",
        "label": "Access Token",
        "type": "password",
        "placeholder": "access_org_..."
      }
    ],
    "envMapping": {
      "MOLLIE_ACCESS_TOKEN": "accessToken"
    }
  },
  "oauth": null,
  "values": {
    "payment-link": {
      "tool": "GetPaymentLink",
      "args": { "paymentLinkId": "$id" },
      "path": "_links.paymentLink.href",
      "allowedHosts": ["payment-links.mollie.com"]
    }
  },
  "toolGating": {
    "default": {
      "executionMapping": {},
      "staticExecution": {
        "action_type": "unclassified"
      }
    },
    "overrides": {
      "ListProfiles": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns the organisation's own payment profile configuration (names, websites, status) — no customer or payment data."
      },
      "GetProfile": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns one of the organisation's own payment profile configurations — no customer or payment data."
      },
      "GetOrganizationDetails": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns the connected Mollie organisation's own name/registration details — no customer or payment data."
      },
      "GetPaymentMethod": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns the organisation's own payment-method configuration (name, image, min/max amount) — no customer or payment data."
      },
      "ListPaymentMethods": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns which payment methods are enabled for the organisation — no customer or payment data."
      },
      "ListAllPaymentMethods": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns every payment method Mollie offers — no customer or payment data."
      },
      "GetTerminal": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns a card-terminal's own configuration (name, status) — no customer or payment data."
      },
      "ListTerminals": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns the organisation's card terminals — no customer or payment data."
      },
      "GetClientDocs": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns Mollie's own API documentation — no customer or payment data."
      },
      "fetch_docs": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Returns Mollie's own API documentation — no customer or payment data."
      },
      "list_doc_sources": {
        "category": "read",
        "readGovernance": "none",
        "readGovernanceReason": "Lists Mollie's own documentation sources — no customer or payment data."
      },
      "GetPayment": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListPaymentsForGivenCustomer": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListPaymentsForGivenPaymentLink": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListPaymentsFromGivenIDOnwards": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListPaymentsWithinSpecifiedTimeInterval": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "SearchPaymentsByDescription": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "AggregatePayments": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetPaymentLink": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListPaymentLinks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListPaymentLinksWithinSpecifiedTimeInterval": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "AggregatePaymentLinks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListCustomers": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "SearchCustomers": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetMandate": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListMandates": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetCapture": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListCaptures": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetBalance": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetPrimaryBalance": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListBalances": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetBalanceReport": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListBalanceTransactions": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetSettlement": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetNextSettlement": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetOpenSettlement": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSettlements": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSettlementCaptures": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSettlementChargebacks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSettlementPayments": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSettlementRefunds": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetSubscription": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListAllSubscriptions": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListCustomerSubscriptions": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSubscriptionPayments": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetInvoice": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListInvoices": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetSalesInvoice": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListSalesInvoices": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetWebhook": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "ListWebhooks": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "GetWebhookEvent": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "CreatePayment": {
        "summary": "Payment of {amount|money}: {description|short}",
        "actionLabel": "Payment created",
        "executionMapping": {
          "amount": "amount",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "charge"
        }
      },
      "CreatePaymentLink": {
        "summary": "Payment link[ of {amount|money}]: {description|short}",
        "actionLabel": "Payment link created",
        "executionMapping": {
          "amount": "amount",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "charge"
        }
      },
      "CreateCapture": {
        "summary": "Capture of {amount_value|money} from payment {payment_id}",
        "actionLabel": "Capture created",
        "display": {
          "currencyField": "amount_currency"
        },
        "executionMapping": {
          "amount_value": "amount",
          "amount_currency": "currency"
        },
        "staticExecution": {
          "action_type": "charge"
        }
      },
      "CreateCustomer": {
        "summary": "Create payment customer[ {name}]",
        "actionLabel": "Payment customer created",
        "executionMapping": {},
        "staticExecution": {
          "action_type": "manage"
        }
      },
      "UpdateCustomer": {
        "summary": "Update payment customer {customer_id}[ — {name}]",
        "actionLabel": "Payment customer updated",
        "executionMapping": {},
        "staticExecution": {
          "action_type": "manage"
        }
      },
      "RevokeMandate": {
        "summary": "Revoke payment authorisation {mandate_id} for customer {customer_id}",
        "actionLabel": "Payment authorisation revoked",
        "executionMapping": {},
        "staticExecution": {
          "action_type": "manage"
        }
      },
      "CreateSalesInvoice": {
        "category": "disabled",
        "_reason": "Invoices come from the ERP (Invoicing profile); Mollie no longer issues invoices."
      },
      "UpdateSalesInvoice": {
        "category": "disabled",
        "_reason": "Invoices come from the ERP; Mollie no longer issues or changes invoices (also the only way to mark one paid by hand, which is excluded by decision)."
      },
      "CancelSubscription": {
        "category": "disabled",
        "_reason": "Subscriptions are read-only in Payments 0.7 — there is no action type to charge this against."
      },
      "UpdateSubscription": {
        "category": "disabled",
        "_reason": "Subscriptions are read-only in Payments 0.7; the new amount is also inside an opaque request_body and cannot be mapped to a bound."
      },
      "CreateWebhook": {
        "category": "disabled",
        "_reason": "Sends payment events to any URL the agent names — a data leak path. Webhooks are set up by a person in the dashboard."
      },
      "UpdateWebhook": {
        "category": "disabled",
        "_reason": "Sends payment events to any URL the agent names — a data leak path. Webhooks are set up by a person in the dashboard."
      },
      "TestWebhook": {
        "category": "disabled",
        "_reason": "Could be pointed at any URL to exfiltrate payment data."
      },
      "CreateDraftTransfer": {
        "category": "disabled",
        "_reason": "Outgoing money to the organisation's own bank account — spend side, not covered by Payments 0.7."
      },
      "CancelDraftTransfer": {
        "category": "disabled",
        "_reason": "Outgoing money — spend side, not covered by Payments 0.7."
      },
      "GetDraftTransfer": {
        "category": "disabled",
        "_reason": "Spend side (payouts) — outside Payments; not covered by this profile."
      },
      "ListDraftTransfers": {
        "category": "disabled",
        "_reason": "Spend side (payouts) — outside Payments; not covered by this profile."
      },
      "ListBusinessAccounts": {
        "category": "disabled",
        "_reason": "Spend side (the organisation's own bank accounts) — outside Payments; not covered by this profile."
      }
    }
  },
  "templates": [
    {
      "name": "See Payments",
      "description": "Read-only. Look up payments, payment links, customers, mandates, settlements and balances.",
      "risk": "low",
      "mode": "automatic",
      "bounds": {
        "read_access": "unlimited",
        "amount_max": "0",
        "amount_daily_max": "0",
        "amount_monthly_max": "0",
        "charge_daily_max": "0",
        "manage_daily_max": "0"
      },
      "context": {
        "currency": "EUR"
      },
      "intent": "Allow the agent to look up payments, payment links, payment customers, settlements and balances. Read-only — nothing is created or changed.",
      "ttl": 2592000,
      "tags": [
        "read-only"
      ]
    },
    {
      "name": "Payment Links up to €50",
      "description": "Create payment links and payments up to €50 per transaction. No read access.",
      "risk": "medium",
      "mode": "automatic",
      "bounds": {
        "read_access": "none",
        "amount_max": "50",
        "amount_daily_max": "200",
        "amount_monthly_max": "2000",
        "charge_daily_max": "20",
        "manage_daily_max": "0"
      },
      "context": {
        "currency": "EUR"
      },
      "intent": "Allow the agent to create payment links and payments for routine amounts. An open-amount link, or one above €50, is refused. No lookups.",
      "ttl": 2592000,
      "tags": [
        "€50/tx",
        "€200/day",
        "20 ops/day"
      ]
    },
    {
      "name": "Full Payment Management",
      "description": "Payments, payment links and payment customers. Every write requires your approval.",
      "risk": "high",
      "mode": "review",
      "bounds": {
        "read_access": "unlimited",
        "amount_max": "1000",
        "amount_daily_max": "5000",
        "amount_monthly_max": "20000",
        "charge_daily_max": "50",
        "manage_daily_max": "20"
      },
      "context": {
        "currency": "EUR"
      },
      "intent": "Full payment management — create payments and payment links, manage payment customers, and look up payments, links, customers and balances. Every write requires human review before execution.",
      "ttl": 2592000,
      "tags": [
        "€1,000/tx",
        "€5,000/day",
        "review mode"
      ]
    }
  ],
  "setupHint": "Use an organization access token (access_org_...), not an API key (test_... or live_...): Mollie's connector needs it to list your profiles. Test payments still work with it.",
  "setupGuide": [
    {
      "title": "Create a Mollie account",
      "description": "Sign up at mollie.com if you don't have an account yet.",
      "link": "https://my.mollie.com/dashboard/signup"
    },
    {
      "title": "Get your access token",
      "description": "Go to Settings > Developer > Access tokens in your Mollie dashboard. Create an Organization access token with read and write access to payments, payment links, profiles, customers and organizations.",
      "link": "https://my.mollie.com/dashboard/developers/api-keys"
    },
    {
      "title": "Enter your token below",
      "description": "Paste the organization access token (access_org_...) in the field below. An API key (test_... or live_...) does not work here."
    }
  ]
}
