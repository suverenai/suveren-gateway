{
  "id": "erp",
  "name": "ERP",
  "version": "1.0.0",
  "description": "Quote-to-order — items, customers, quotes, orders",
  "icon": "briefcase",
  "profile": "sales",
  "npmPackage": "@humanagencyp/erp-mcp",
  "npmVersion": "0.9.2",
  "mcp": {
    "command": "erp-mcp",
    "args": [],
    "passEnv": ["ERP_COMPANY_FILE"]
  },
  "credentials": {
    "fields": [
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      },
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs an adapter for your ERP",
        "optional": true
      },
      {
        "key": "liveAdapter",
        "label": "Live adapter (optional)",
        "type": "text",
        "placeholder": "local — your own company's invoicing. Leave empty unless Mode is \"live\"",
        "optional": true
      },
      {
        "key": "companyFile",
        "label": "Company data file (optional)",
        "type": "text",
        "placeholder": "Path to your company file (name, address, UID, bank, VAT mode) — required when the live adapter is \"local\"",
        "optional": true
      },
      {
        "key": "invoiceTemplate",
        "label": "Invoice template (optional)",
        "type": "text",
        "placeholder": "Path to an invoice template file — leave empty for the bundled German template",
        "optional": true
      }
    ],
    "envMapping": {
      "DATABASE_URL": "databaseUrl",
      "ERP_MODE": "mode",
      "ERP_LIVE_ADAPTER": "liveAdapter",
      "ERP_LIVE_COMPANY_FILE": "companyFile",
      "ERP_INVOICE_TEMPLATE": "invoiceTemplate"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "modeLabels": {
    "simulation": "Test data",
    "live": { "local": "Local" }
  },
  "modeNotes": {
    "live": { "local": "On this computer — no shared access" }
  },
  "adapterField": "liveAdapter",
  "personalDefault": true,
  "oauth": null,
  "documents": {
    "invoice-pdf": {
      "tool": "get_document",
      "args": { "kind": "invoice-pdf", "id": "$id" },
      "label": "issued invoice {id}"
    },
    "credit-note-pdf": {
      "tool": "get_document",
      "args": { "kind": "credit-note-pdf", "id": "$id" },
      "label": "issued credit note {id}"
    }
  },
  "context": {
    "recordKeys": {
      "customer": {
        "read": { "tool": "get_customer", "args": { "id": "$id" } },
        "keys": { "email": "email" }
      },
      "quote": {
        "read": { "tool": "get_quote", "args": { "id": "$id" } },
        "next": { "recordKey": "customer", "field": "customer_id" }
      }
    }
  },
  "toolGating": {
    "default": {
      "executionMapping": {},
      "staticExecution": {}
    },
    "overrides": {
      "list_items": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_item": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "find_customers": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_customer": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_quotes": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_quote": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_orders": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_order": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "create_quote": {
        "summary": "Quote of {value|money} net[ — {discount_pct|percent} discount]",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "quote"
        },
        "actionLabel": "Quote drafted",
        "contextKeys": { "customer": "customer_id" },
        "preview": [
          { "tool": "get_customer", "args": { "id": "customer_id" }, "attach": "customer_id" },
          { "tool": "get_item", "forEach": "lines", "args": { "id": "item_id" }, "attach": "item" }
        ],
        "display": {
          "order": ["customer_id", "lines", "discount_pct", "value", "valid_until", "notes"],
          "money": ["value", "customer_id.credit_limit", "customer_id.open_balance", "customer_id.available_credit", "lines[].item.list_price"],
          "percent": ["discount_pct"],
          "currencyField": "currency",
          "labels": {
            "customer_id": "Customer",
            "discount_pct": "Discount",
            "value": "Total (net)",
            "customer_id.credit_limit": "Credit limit",
            "customer_id.open_balance": "Open balance",
            "customer_id.available_credit": "Available credit",
            "customer_id.payment_terms": "Payment terms",
            "lines[].item": "Item",
            "lines[].item.list_price": "List price",
            "lines[].item.stock": "In stock"
          }
        }
      },
      "update_quote": {
        "summary": "Update quote to {value|money} net[ — {discount_pct|percent} discount]",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "quote"
        },
        "actionLabel": "Quote updated",
        "contextKeys": { "quote": "id" },
        "preview": [
          { "tool": "get_item", "forEach": "lines", "args": { "id": "item_id" }, "attach": "item" }
        ],
        "display": {
          "order": ["lines", "discount_pct", "value", "valid_until", "notes"],
          "money": ["value", "lines[].item.list_price"],
          "percent": ["discount_pct"],
          "currencyField": "currency",
          "labels": {
            "discount_pct": "Discount",
            "value": "Total (net)",
            "lines[].item": "Item",
            "lines[].item.list_price": "List price",
            "lines[].item.stock": "In stock"
          }
        }
      },
      "send_quote": {
        "summary": "Send quote of {value|money} net[ — {discount_pct|percent} discount]",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "send"
        },
        "actionLabel": "Quote sent",
        "contextKeys": { "quote": "id" },
        "preview": {
          "tool": "get_quote",
          "args": { "id": "id", "revision": "revision" },
          "version": { "arg": "revision", "field": "revision" },
          "fields": ["number", "revision", "status", "customer_id", "lines", "net_total", "discount_pct", "valid_until"]
        }
      },
      "convert_quote_to_order": {
        "summary": "Order of {value|money} net from a quote",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "order"
        },
        "actionLabel": "Quote converted to order",
        "contextKeys": { "quote": "id" },
        "preview": {
          "tool": "get_quote",
          "args": { "id": "id", "revision": "revision" },
          "version": { "arg": "revision", "field": "revision" },
          "fields": ["number", "revision", "status", "customer_id", "lines", "net_total", "discount_pct", "valid_until"]
        }
      },
      "create_invoice": {
        "profile": "invoicing",
        "summary": "Invoice[ {number}] of {net_total|money} net to {customer_id}[ for order {order_id}]",
        "executionMapping": {
          "net_total": "net_total",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "invoice"
        },
        "actionLabel": "Invoice issued",
        "contextKeys": { "customer": "customer_id" },
        "preview": [
          { "tool": "get_customer", "args": { "id": "customer_id" }, "attach": "customer_id" },
          {
            "tool": "preview_invoice",
            "args": {
              "customer_id": "customer_id",
              "number": "number",
              "document_date": "document_date",
              "service_period": "service_period",
              "lines": "lines",
              "net_total": "net_total",
              "currency": "currency",
              "payment_term_days": "payment_term_days",
              "memo": "memo"
            },
            "kind": "document"
          }
        ],
        "display": {
          "order": ["customer_id", "order_id", "number", "document_date", "service_period", "lines", "net_total", "currency", "payment_term_days", "memo"],
          "money": ["net_total", "lines[].unit_price", "customer_id.credit_limit", "customer_id.open_balance", "customer_id.available_credit"],
          "currencyField": "currency",
          "labels": {
            "customer_id": "Customer",
            "order_id": "Order",
            "number": "Invoice number",
            "document_date": "Invoice date",
            "service_period": "Service period",
            "net_total": "Total (net)",
            "payment_term_days": "Payment terms (days)",
            "memo": "Memo",
            "customer_id.credit_limit": "Credit limit",
            "customer_id.open_balance": "Open balance",
            "customer_id.available_credit": "Available credit"
          }
        }
      },
      "create_credit_note": {
        "profile": "invoicing",
        "summary": "Credit note[ {number}] of {credit_total|money} net for invoice {invoice_id}: {reason|short}",
        "executionMapping": {
          "credit_total": "credit_total",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "credit"
        },
        "actionLabel": "Credit note issued",
        "preview": {
          "tool": "get_invoice",
          "args": { "id": "invoice_id" },
          "fields": ["number", "customer_id", "net_total", "currency", "status"]
        },
        "display": {
          "order": ["invoice_id", "number", "document_date", "credit_total", "currency", "reason", "service_period", "lines"],
          "money": ["credit_total", "lines[].unit_price"],
          "currencyField": "currency",
          "labels": {
            "invoice_id": "Invoice",
            "number": "Credit note number",
            "document_date": "Credit note date",
            "credit_total": "Total (net)",
            "reason": "Reason",
            "service_period": "Service period"
          }
        }
      },
      "preview_invoice": {
        "profile": "invoicing",
        "category": "read",
        "internal": true
      },
      "get_document": {
        "profile": "invoicing",
        "category": "read",
        "internal": true
      },
      "list_invoices": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_invoice": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_credit_notes": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_credit_note": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "load_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "action_type": "setup"
        },
        "actionLabel": "Test data loaded",
        "hideUnlessAuthorized": true,
        "simulationOnly": true
      },
      "clear_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "action_type": "setup"
        },
        "actionLabel": "Test data cleared",
        "hideUnlessAuthorized": true,
        "simulationOnly": true
      }
    }
  },
  "setupHint": "No configuration needed — works out of the box.",
  "setupGuide": [
    {
      "title": "Ready to use",
      "description": "The ERP connector stores data locally on your machine, seeded with a small demo catalog and customer list. No external account or API key needed."
    },
    {
      "title": "Optional: use a shared database",
      "description": "For team use, provide a PostgreSQL connection string in the Database URL field. Otherwise, leave it empty to use local SQLite storage."
    }
  ]
}
