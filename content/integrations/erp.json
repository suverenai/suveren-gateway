{
  "id": "erp",
  "name": "ERP",
  "version": "1.0.0",
  "description": "Quote-to-order — items, customers, quotes, orders",
  "icon": "briefcase",
  "profile": "sales",
  "npmPackage": "@humanagencyp/erp-mcp",
  "npmVersion": "0.9.5",
  "mcp": {
    "command": "erp-mcp",
    "args": [],
    "passEnv": ["ERP_COMPANY_FILE"]
  },
  "credentials": {
    "fields": [
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      },
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs an adapter for your ERP",
        "optional": true
      },
      {
        "key": "liveAdapter",
        "label": "Live adapter (optional)",
        "type": "text",
        "placeholder": "local — your own company's invoicing. Leave empty unless Mode is \"live\"",
        "optional": true
      },
      {
        "key": "companyFile",
        "label": "Company data file (optional)",
        "type": "text",
        "placeholder": "Path to your company file (name, address, UID, bank, VAT mode) — required when the live adapter is \"local\"",
        "optional": true
      },
      {
        "key": "invoiceTemplate",
        "label": "Invoice template (optional)",
        "type": "text",
        "placeholder": "Path to an invoice template file — leave empty for the bundled German template",
        "optional": true
      },
      {
        "key": "quoteTemplate",
        "label": "Quote template (optional)",
        "type": "text",
        "placeholder": "Path to a quote template file — leave empty for the bundled German template",
        "optional": true
      },
      {
        "key": "viesCheck",
        "label": "VAT-ID check (optional)",
        "type": "text",
        "placeholder": "on (default) — \"off\" saves every VAT ID as not checked",
        "optional": true
      }
    ],
    "envMapping": {
      "DATABASE_URL": "databaseUrl",
      "ERP_MODE": "mode",
      "ERP_LIVE_ADAPTER": "liveAdapter",
      "ERP_LIVE_COMPANY_FILE": "companyFile",
      "ERP_INVOICE_TEMPLATE": "invoiceTemplate",
      "ERP_QUOTE_TEMPLATE": "quoteTemplate",
      "ERP_VIES": "viesCheck"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "modeLabels": {
    "simulation": "Test data",
    "live": { "local": "Local" }
  },
  "modeNotes": {
    "live": { "local": "On this computer. VAT-ID checks ask the EU VIES service." }
  },
  "network": [
    {
      "modes": { "live": ["local"] },
      "host": "ec.europa.eu",
      "purpose": "EU VAT-ID check (VIES) when a customer's VAT ID is saved or shown for approval",
      "sends": "the customer's country and VAT ID, and your own VAT ID"
    }
  ],
  "adapterField": "liveAdapter",
  "personalDefault": true,
  "oauth": null,
  "documents": {
    "invoice-pdf": {
      "tool": "get_document",
      "args": { "kind": "invoice-pdf", "id": "$id" },
      "label": "issued invoice {id}"
    },
    "credit-note-pdf": {
      "tool": "get_document",
      "args": { "kind": "credit-note-pdf", "id": "$id" },
      "label": "issued credit note {id}"
    },
    "quote-pdf": {
      "tool": "get_document",
      "args": { "kind": "quote-pdf", "id": "$id" },
      "label": "quote {id}"
    }
  },
  "context": {
    "recordKeys": {
      "customer": {
        "read": { "tool": "get_customer", "args": { "id": "$id" } },
        "keys": { "email": "email" }
      },
      "quote": {
        "read": { "tool": "get_quote", "args": { "id": "$id" } },
        "next": { "recordKey": "customer", "field": "customer_id" }
      }
    }
  },
  "toolGating": {
    "default": {
      "executionMapping": {},
      "staticExecution": {}
    },
    "overrides": {
      "list_items": {
        "readAlsoUnder": ["invoicing", "master-data"],
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_item": {
        "readAlsoUnder": ["invoicing", "master-data"],
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "find_customers": {
        "readAlsoUnder": ["invoicing", "master-data"],
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_customer": {
        "readAlsoUnder": ["invoicing", "master-data"],
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_quotes": {
        "readAlsoUnder": ["invoicing"],
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_quote": {
        "readAlsoUnder": ["invoicing"],
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_orders": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_order": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "create_quote": {
        "summary": "Quote[ {number}] of {value|money} net[ — {discount_pct|percent} discount]",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "quote"
        },
        "actionLabel": "Quote drafted",
        "contextKeys": { "customer": "customer_id" },
        "preview": [
          { "tool": "get_customer", "args": { "id": "customer_id" }, "attach": "customer_id" },
          { "tool": "get_item", "forEach": "lines", "args": { "id": "item_id" }, "attach": "item", "when": "item_id" }
        ],
        "checks": [
          { "key": "list-price", "label": "Line price = list price", "forEach": "lines", "when": "lines[].item_id",
            "path": "lines[].unit_price", "compare": { "op": "eq", "to": "lines[].item.list_price" },
            "onTrue": "pass", "onFalse": "notice",
            "detail": "line {#}: {lines[].unit_price|money} — list price {lines[].item.list_price|money}" },
          { "key": "item-vat", "label": "Line VAT = item VAT rate", "forEach": "lines", "when": "lines[].item_id",
            "path": "lines[].vat_rate", "compare": { "op": "eq", "to": "lines[].item.vat_rate" },
            "onTrue": "pass", "onFalse": "notice",
            "detail": "line {#}: {lines[].vat_rate|percent} — item {lines[].item.vat_rate|percent}" }
        ],
        "display": {
          "order": ["customer_id", "number", "document_date", "lines", "discount_pct", "value", "valid_until", "notes"],
          "money": ["value", "customer_id.credit_limit", "customer_id.open_balance", "customer_id.available_credit", "lines[].item.list_price", "lines[].unit_price"],
          "percent": ["discount_pct", "lines[].vat_rate", "lines[].item.vat_rate"],
          "currencyField": "currency",
          "labels": {
            "customer_id": "Customer",
            "customer_id.uid": "VAT ID",
            "number": "Quote number",
            "document_date": "Quote date",
            "lines[].description": "Description",
            "lines[].unit_price": "Price",
            "lines[].vat_rate": "VAT rate",
            "lines[].item.vat_rate": "Item VAT rate",
            "discount_pct": "Discount",
            "value": "Total (net)",
            "customer_id.credit_limit": "Credit limit",
            "customer_id.open_balance": "Open balance",
            "customer_id.available_credit": "Available credit",
            "customer_id.payment_terms": "Payment terms",
            "lines[].item": "Item",
            "lines[].item.list_price": "List price",
            "lines[].item.stock": "In stock"
          }
        }
      },
      "update_quote": {
        "summary": "Update quote to {value|money} net[ — {discount_pct|percent} discount]",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "quote"
        },
        "actionLabel": "Quote updated",
        "contextKeys": { "quote": "id" },
        "preview": [
          { "tool": "get_quote", "args": { "id": "id", "revision": "revision" }, "attach": "id", "when": "revision",
            "version": { "arg": "revision", "field": "revision" } },
          { "tool": "get_item", "forEach": "lines", "args": { "id": "item_id" }, "attach": "item", "when": "item_id" }
        ],
        "checks": [
          { "key": "list-price", "label": "Line price = list price", "forEach": "lines", "when": "lines[].item_id",
            "path": "lines[].unit_price", "compare": { "op": "eq", "to": "lines[].item.list_price" },
            "onTrue": "pass", "onFalse": "notice",
            "detail": "line {#}: {lines[].unit_price|money} — list price {lines[].item.list_price|money}" },
          { "key": "item-vat", "label": "Line VAT = item VAT rate", "forEach": "lines", "when": "lines[].item_id",
            "path": "lines[].vat_rate", "compare": { "op": "eq", "to": "lines[].item.vat_rate" },
            "onTrue": "pass", "onFalse": "notice",
            "detail": "line {#}: {lines[].vat_rate|percent} — item {lines[].item.vat_rate|percent}" }
        ],
        "display": {
          "order": ["id", "lines", "discount_pct", "value", "valid_until", "notes"],
          "money": ["value", "lines[].item.list_price", "lines[].unit_price", "id.net_total"],
          "percent": ["discount_pct", "lines[].vat_rate", "lines[].item.vat_rate"],
          "currencyField": "currency",
          "labels": {
            "id": "Quote",
            "id.net_total": "Total (net, now)",
            "discount_pct": "Discount",
            "value": "Total (net)",
            "lines[].item": "Item",
            "lines[].item.list_price": "List price",
            "lines[].item.stock": "In stock"
          }
        }
      },
      "send_quote": {
        "summary": "Send quote of {value|money} net[ — {discount_pct|percent} discount]",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "send"
        },
        "actionLabel": "Quote sent",
        "contextKeys": { "quote": "id" },
        "preview": {
          "tool": "get_quote",
          "args": { "id": "id", "revision": "revision" },
          "version": { "arg": "revision", "field": "revision" },
          "fields": ["number", "revision", "status", "customer_id", "lines", "net_total", "discount_pct", "valid_until"]
        }
      },
      "convert_quote_to_order": {
        "summary": "Order of {value|money} net from a quote",
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "order"
        },
        "actionLabel": "Quote converted to order",
        "contextKeys": { "quote": "id" },
        "preview": {
          "tool": "get_quote",
          "args": { "id": "id", "revision": "revision" },
          "version": { "arg": "revision", "field": "revision" },
          "fields": ["number", "revision", "status", "customer_id", "lines", "net_total", "discount_pct", "valid_until"]
        }
      },
      "create_invoice": {
        "profile": "invoicing",
        "summary": "Invoice[ {number}] of {net_total|money} net to {customer_id}[ for order {order_id}]",
        "executionMapping": {
          "net_total": "net_total",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "invoice"
        },
        "actionLabel": "Invoice issued",
        "contextKeys": { "customer": "customer_id" },
        "preview": [
          { "tool": "get_customer", "args": { "id": "customer_id", "revision": "customer_revision" }, "attach": "customer_id",
            "version": { "arg": "customer_revision", "field": "revision" } },
          { "tool": "get_quote", "args": { "id": "quote_id", "revision": "quote_revision" }, "attach": "quote_id", "when": "quote_id",
            "version": { "arg": "quote_revision", "field": "revision" } },
          { "tool": "get_item", "forEach": "lines", "args": { "id": "item_id" }, "attach": "item", "when": "item_id" },
          {
            "tool": "preview_invoice",
            "args": {
              "customer_id": "customer_id",
              "number": "number",
              "document_date": "document_date",
              "service_period": "service_period",
              "lines": "lines",
              "net_total": "net_total",
              "currency": "currency",
              "payment_term_days": "payment_term_days",
              "memo": "memo",
              "quote_id": "quote_id",
              "quote_revision": "quote_revision",
              "customer_revision": "customer_revision"
            },
            "kind": "document"
          }
        ],
        "checks": [
          { "key": "vies", "label": "Customer VAT ID confirmed by VIES", "when": "customer_id.uid",
            "path": "customer_id.vies.status", "pass": ["valid"], "fail": ["invalid"], "notChecked": ["not_checked", null],
            "notice": ["not_applicable"], "missing": "not_checked",
            "detail": "[checked {customer_id.vies.checked_at|date}][ — {customer_id.vies.reason}]" },
          { "key": "list-price", "label": "Line price = list price", "forEach": "lines", "when": "lines[].item_id",
            "path": "lines[].unit_price", "compare": { "op": "eq", "to": "lines[].item.list_price" },
            "onTrue": "pass", "onFalse": "notice",
            "detail": "line {#}: {lines[].unit_price|money} — list price {lines[].item.list_price|money}" },
          { "key": "item-vat", "label": "Line VAT = item VAT rate", "forEach": "lines", "when": "lines[].item_id",
            "path": "lines[].vat_rate", "compare": { "op": "eq", "to": "lines[].item.vat_rate" },
            "onTrue": "pass", "onFalse": "notice",
            "detail": "line {#}: {lines[].vat_rate|percent} — item {lines[].item.vat_rate|percent}" }
        ],
        "display": {
          "order": ["customer_id", "quote_id", "quote_revision", "customer_revision", "order_id", "number", "document_date", "service_period", "lines", "net_total", "currency", "payment_term_days", "memo"],
          "money": ["net_total", "lines[].unit_price", "customer_id.credit_limit", "customer_id.open_balance", "customer_id.available_credit", "lines[].item.list_price", "quote_id.net_total"],
          "percent": ["lines[].vat_rate", "lines[].item.vat_rate"],
          "currencyField": "currency",
          "hidden": ["customer_id.vies.status", "customer_id.vies.reason", "customer_id.vies.request_id"],
          "labels": {
            "customer_id": "Customer",
            "quote_id": "Quote",
            "quote_revision": "Quote revision",
            "customer_revision": "Customer revision",
            "lines[].item": "Item",
            "lines[].item.list_price": "List price",
            "lines[].item.vat_rate": "Item VAT rate",
            "customer_id.uid": "VAT ID",
            "customer_id.vies.checked_at": "VIES checked",
            "order_id": "Order",
            "number": "Invoice number",
            "document_date": "Invoice date",
            "service_period": "Service period",
            "net_total": "Total (net)",
            "payment_term_days": "Payment terms (days)",
            "memo": "Memo",
            "customer_id.credit_limit": "Credit limit",
            "customer_id.open_balance": "Open balance",
            "customer_id.available_credit": "Available credit"
          }
        }
      },
      "create_credit_note": {
        "profile": "invoicing",
        "summary": "Credit note[ {number}] of {credit_total|money} net for invoice {invoice_id}: {reason|short}",
        "executionMapping": {
          "credit_total": "credit_total",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "credit"
        },
        "actionLabel": "Credit note issued",
        "preview": {
          "tool": "get_invoice",
          "args": { "id": "invoice_id" },
          "fields": ["number", "customer_id", "net_total", "currency", "status"]
        },
        "display": {
          "order": ["invoice_id", "number", "document_date", "credit_total", "currency", "reason", "service_period", "lines"],
          "money": ["credit_total", "lines[].unit_price"],
          "currencyField": "currency",
          "labels": {
            "invoice_id": "Invoice",
            "number": "Credit note number",
            "document_date": "Credit note date",
            "credit_total": "Total (net)",
            "reason": "Reason",
            "service_period": "Service period"
          }
        }
      },
      "preview_invoice": {
        "profile": "invoicing",
        "category": "read",
        "internal": true
      },
      "get_document": {
        "profile": "invoicing",
        "category": "read",
        "internal": true
      },
      "check_vat_id": {
        "profile": "master-data",
        "category": "read",
        "internal": true
      },
      "preview_customer_change": {
        "profile": "master-data",
        "category": "read",
        "internal": true
      },
      "preview_quote": {
        "category": "read",
        "internal": true
      },
      "list_invoices": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_invoice": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_credit_notes": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_credit_note": {
        "profile": "invoicing",
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "create_customer": {
        "profile": "master-data",
        "summary": "New customer {name}, {country}[ — VAT ID {uid}]",
        "executionMapping": {},
        "staticExecution": { "action_type": "customer_create" },
        "actionLabel": "Customer created",
        "preview": [
          { "tool": "check_vat_id", "args": { "country": "country", "uid": "uid" }, "attach": "uid", "when": "uid", "displayOnly": true }
        ],
        "checks": [
          { "key": "vat-format", "label": "VAT ID format", "when": "uid", "path": "uid.format",
            "pass": ["ok", "not_applicable"], "fail": ["wrong_prefix", "wrong_pattern"], "missing": "not_checked" },
          { "key": "vies", "label": "VAT ID confirmed by VIES", "when": "uid", "path": "uid.vies.status",
            "pass": ["valid"], "fail": ["invalid"], "notChecked": ["not_checked"], "notice": ["not_applicable"], "missing": "not_checked",
            "detail": "[checked {uid.vies.checked_at|date}][ — {uid.vies.reason} — saving is not blocked while VIES is unreachable]" },
          { "key": "duplicate", "label": "No other customer with this VAT ID", "when": "uid",
            "path": "uid.duplicate", "pass": [false], "fail": [true],
            "detail": "[already customer {uid.duplicate_of}]" }
        ],
        "display": {
          "order": ["name", "address_lines", "country", "uid", "email", "crm_contact_id"],
          "labels": {
            "name": "Name", "address_lines": "Address", "country": "Country", "uid": "VAT ID",
            "email": "Email", "crm_contact_id": "CRM contact",
            "uid.vies.name": "Name at VIES", "uid.vies.address": "Address at VIES", "uid.vies.checked_at": "VIES checked"
          },
          "hidden": ["uid.uid", "uid.format", "uid.vies.status", "uid.vies.reason", "uid.duplicate", "uid.duplicate_of", "uid.vies.request_id"]
        }
      },
      "update_customer": {
        "profile": "master-data",
        "summary": "Change contact data of customer {id}",
        "executionMapping": {},
        "staticExecution": { "action_type": "customer_update" },
        "actionLabel": "Customer updated",
        "preview": [
          { "tool": "get_customer", "args": { "id": "id", "revision": "revision" }, "attach": "id",
            "version": { "arg": "revision", "field": "revision" } }
        ],
        "display": {
          "order": ["id", "email", "crm_contact_id"],
          "labels": {
            "id": "Customer", "email": "Email (new)", "crm_contact_id": "CRM contact (new)",
            "id.email": "Email (now)", "id.crm_contact_id": "CRM contact (now)"
          }
        }
      },
      "update_customer_tax_data": {
        "profile": "master-data",
        "summary": "Change tax data of customer {id}: {name}, {country}[ — VAT ID {uid}]",
        "executionMapping": {},
        "staticExecution": { "action_type": "customer_tax" },
        "actionLabel": "Customer tax data changed",
        "preview": [
          { "tool": "preview_customer_change",
            "args": { "id": "id", "name": "name", "address_lines": "address_lines", "country": "country", "uid": "uid" },
            "attach": "id", "version": { "arg": "revision", "field": "revision" } }
        ],
        "checks": [
          { "key": "vies", "label": "New VAT ID confirmed by VIES", "when": "uid", "path": "id.vat_check.vies.status",
            "pass": ["valid"], "fail": ["invalid"], "notChecked": ["not_checked"], "notice": ["not_applicable"], "missing": "not_checked",
            "detail": "[checked {id.vat_check.vies.checked_at|date}][ — {id.vat_check.vies.reason} — saving is not blocked while VIES is unreachable]" },
          { "key": "duplicate", "label": "No other customer with this VAT ID", "when": "uid",
            "path": "id.vat_check.duplicate", "pass": [false], "fail": [true],
            "detail": "[already customer {id.vat_check.duplicate_of}]" },
          { "key": "tax-mode", "label": "Tax treatment of future invoices", "path": "id.tax_mode.after",
            "compare": { "op": "eq", "to": "id.tax_mode.now" }, "onTrue": "pass", "onFalse": "notice",
            "detail": "{id.tax_mode.now} → {id.tax_mode.after}" },
          { "key": "already-invoiced", "label": "Already issued to this customer", "when": "id.uid_or_country_changed",
            "path": "id.issued_documents.invoices", "compare": { "op": "gt", "to": 0 }, "onTrue": "notice", "onFalse": "pass",
            "detail": "{id.issued_documents.invoices} invoices, {id.issued_documents.credit_notes} credit notes — they keep the old data" }
        ],
        "display": {
          "order": ["id", "name", "address_lines", "country", "uid"],
          "labels": {
            "id": "Customer", "name": "Name (new)", "address_lines": "Address (new)", "country": "Country (new)", "uid": "VAT ID (new)",
            "id.current.name": "Name (now)", "id.current.address_lines": "Address (now)",
            "id.current.country": "Country (now)", "id.current.uid": "VAT ID (now)",
            "id.open_quotes": "Open quotes (made with the old data)"
          },
          "hidden": ["id.vat_check", "id.tax_mode", "id.issued_documents", "id.changed", "id.revision", "id.uid_or_country_changed", "id.current.revision"]
        }
      },
      "create_item": {
        "profile": "master-data",
        "summary": "New item {name} at {list_price|money} per {unit}, VAT {vat_rate|percent}",
        "executionMapping": { "list_price": "list_price" },
        "staticExecution": { "action_type": "item_create" },
        "actionLabel": "Item created",
        "display": {
          "order": ["name", "kind", "unit", "list_price", "vat_rate", "sku", "description"],
          "money": ["list_price"],
          "percent": ["vat_rate"],
          "labels": {
            "name": "Name", "kind": "Kind", "unit": "Unit", "list_price": "List price (net)",
