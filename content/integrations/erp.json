{
  "id": "erp",
  "name": "ERP",
  "version": "1.0.0",
  "description": "Quote-to-order — items, customers, quotes, orders",
  "icon": "briefcase",
  "profile": "sales",
  "npmPackage": "@humanagencyp/erp-mcp",
  "npmVersion": "0.3.3",
  "mcp": {
    "command": "erp-mcp",
    "args": []
  },
  "credentials": {
    "fields": [
      {
        "key": "databaseUrl",
        "label": "Database URL (optional)",
        "type": "text",
        "placeholder": "Leave empty for local SQLite",
        "optional": true
      },
      {
        "key": "mode",
        "label": "Mode (optional)",
        "type": "text",
        "placeholder": "simulation (default) — live needs an adapter for your ERP",
        "optional": true
      }
    ],
    "envMapping": {
      "DATABASE_URL": "databaseUrl",
      "ERP_MODE": "mode"
    }
  },
  "simulation": {
    "field": "mode",
    "default": "simulation"
  },
  "personalDefault": true,
  "oauth": null,
  "toolGating": {
    "default": {
      "executionMapping": {},
      "staticExecution": {}
    },
    "overrides": {
      "list_items": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_item": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "find_customers": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_customer": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_quotes": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_quote": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "list_orders": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "get_order": {
        "category": "read",
        "boundField": "read_access",
        "requiredValue": "unlimited"
      },
      "create_quote": {
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "quote"
        },
        "actionLabel": "Quote drafted"
      },
      "update_quote": {
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "quote"
        },
        "actionLabel": "Quote updated"
      },
      "send_quote": {
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "send"
        },
        "actionLabel": "Quote sent"
      },
      "convert_quote_to_order": {
        "executionMapping": {
          "value": "value",
          "discount_pct": "discount_pct",
          "currency": "currency"
        },
        "staticExecution": {
          "action_type": "order"
        },
        "actionLabel": "Quote converted to order"
      },
      "load_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "action_type": "setup"
        },
        "actionLabel": "Test data loaded",
        "hideUnlessAuthorized": true
      },
      "clear_simulation": {
        "executionMapping": {},
        "staticExecution": {
          "action_type": "setup"
        },
        "actionLabel": "Test data cleared",
        "hideUnlessAuthorized": true
      }
    }
  },
  "setupHint": "No configuration needed — works out of the box.",
  "setupGuide": [
    {
      "title": "Ready to use",
      "description": "The ERP connector stores data locally on your machine, seeded with a small demo catalog and customer list. No external account or API key needed."
    },
    {
      "title": "Optional: use a shared database",
      "description": "For team use, provide a PostgreSQL connection string in the Database URL field. Otherwise, leave it empty to use local SQLite storage."
    }
  ]
}
