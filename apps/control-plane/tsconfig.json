{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src"
  },
  "include": ["src/**/*"],
  // The interop tests import the phone app's sources: they are typechecked by tsconfig.interop.json.
  "exclude": ["node_modules", "dist", "src/__tests__/device-pairing.test.ts", "src/__tests__/phone-confirmation.test.ts"]
}
