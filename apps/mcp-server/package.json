{
  "name": "@suveren/mcp-server",
  "version": "0.1.0",
  "private": true,
  "description": "Suveren MCP Server — agent tool provider with embedded Gatekeeper",
  "main": "./src/index.ts",
  "scripts": {
    "build": "tsc --noEmit -p tsconfig.json && tsup bin/http.ts bin/report-verify-cli.ts --format esm --outDir dist",
    "start": "node dist/http.mjs",
    "dev": "SUVEREN_INTERNAL_SECRET=${SUVEREN_INTERNAL_SECRET:-dev-shared-internal-secret} SUVEREN_DATA_DIR=${SUVEREN_DATA_DIR:-$HOME/.suveren} SUVEREN_MCP_PORT=3431 tsx --watch bin/http.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "report:post-sample": "node scripts/post-sample-report.mjs"
  },
  "dependencies": {
    "@hap/core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^4.22.3",
    "htmlparser2": "^12.0.0",
    "sanitize-html": "^2.18.0",
    "undici": "^7.30.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/sanitize-html": "^2.16.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^1.0.0"
  }
}
